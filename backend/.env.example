# Required: The target URL where guest requests are forwarded (e.g. demo receiver or main backend)
MAIN_BACKEND_URL=http://127.0.0.1:9100/in

# Optional: Bearer key sent in Authorization header to main backend
MAIN_BACKEND_API_KEY=

# Security Keys (Optional for local testing; defaults are used if left out)
SECRET_KEY=change-me
STAFF_API_KEY=staff-secret
ADMIN_API_KEY=admin-secret
SESSION_TTL_SECONDS=1800

