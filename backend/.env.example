# Security Keys
SECRET_KEY=change-to-a-secure-random-string
STAFF_API_KEY=staff-secret-key
ADMIN_API_KEY=admin-secret-key
SESSION_TTL_SECONDS=1800

# Firebase Realtime Database
# 1. Path to your service account JSON file (e.g. firebase_key.json in backend/):
FIREBASE_CREDENTIALS_PATH=firebase_key.json

# OR 2. Raw JSON string of your service account (useful for Vercel / serverless deployments):
# FIREBASE_CREDENTIALS_JSON={"type":"service_account",...}

# Your Firebase Realtime Database URL:
FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com/

# Optional: Main Backend Webhook Forwarding
MAIN_BACKEND_URL=
MAIN_BACKEND_API_KEY=
