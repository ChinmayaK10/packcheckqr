# Generate long random values, e.g.: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me
STAFF_API_KEY=change-me-staff
ADMIN_API_KEY=change-me-admin

# Optional: forward every new request to your main application
MAIN_BACKEND_URL=http://127.0.0.1:9100/in
MAIN_BACKEND_API_KEY=

# Optional
# For a no-persistence demo backend, use in-memory SQLite:
# NO_DB=1
